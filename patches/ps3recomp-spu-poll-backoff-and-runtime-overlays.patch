+/* Register code a program loads into its own local store at run time from a
+ * source whose main-memory address is not fixed (SEGA Rally's MultiStream
+ * loads flashATRAC.pic from /dev_flash into a heap buffer, and two of the
+ * title's own SPU images, at fixed local-store addresses). Its functions were
+ * lifted at load_lsa under image_id. A dispatch miss in a context running
+ * owner_image_id inside [load_lsa, load_lsa + span) compares the segments with
+ * local store; on a match the span becomes resident (verified) in a free
+ * resident-code slot, and any later DMA into the span ends that, as for
+ * spu_overlay_register_verified_region. Returns 1 on success. */
+int spu_overlay_register_static(int owner_image_id, uint32_t load_lsa, uint32_t span,
+    int image_id, const spu_overlay_code_segment* code, unsigned count);
