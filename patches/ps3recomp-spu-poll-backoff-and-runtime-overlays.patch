 /* Returns 1 if `cmd` is an atomic line op and was handled here, else 0. */
+/* An SPU job worker that polls a line with GETLLAR and finds it unchanged is
+ * idle. On the PS3 that spin costs nothing but the SPU; here each SPU is a host
+ * thread, and SEGA Rally's four job workers (no blocking wait anywhere in
+ * their program) kept four host cores at 100% the whole game. After
+ * SPU_POLL_SPIN (default 200) unchanged reads of the same line in a row the
+ * thread sleeps ~20 us (about 70 us with Linux timer slack) per poll, which
+ * caps an idle worker at a few percent of a core and delays picking up new
+ * work by well under a frame. Yielding instead is not enough: two of the four
+ * poll a line that changes every few ms, and a yield on an idle core returns
+ * at once. A change in the line, or a different line, resets it.
+ * SPU_POLL_SPIN=0 turns it off. Called after the lock-line lock is dropped. */
+static void spu_poll_backoff(uint32_t ea, const uint8_t* line)
+{
+    static int s_spin = -1;
+    if (s_spin < 0) { const char* e = getenv("SPU_POLL_SPIN"); s_spin = e ? atoi(e) : 200; }
+    if (s_spin <= 0) return;
+    static SPU_THREAD_LOCAL uint32_t t_ea = 1, t_n;   /* 1: no line is ever unaligned */
+    static SPU_THREAD_LOCAL uint8_t t_line[MFC_ATOMIC_LINE];
+    if (ea != t_ea || memcmp(t_line, line, MFC_ATOMIC_LINE) != 0) {
+        t_ea = ea; t_n = 0;
+        memcpy(t_line, line, MFC_ATOMIC_LINE);
+        return;
+    }
+    if (++t_n < (uint32_t)s_spin) return;
+#ifdef _WIN32
+    Sleep(0);
+#else
+    const struct timespec ts = { 0, 20000 };
+    nanosleep(&ts, NULL);
+#endif
+}
