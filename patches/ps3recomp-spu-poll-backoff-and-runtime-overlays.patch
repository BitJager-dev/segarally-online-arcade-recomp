+} s_ovl_static[SPU_OVL_STATIC_MAX];
+
+int spu_overlay_register_static(int owner_image_id, uint32_t load_lsa, uint32_t span,
+    int image_id, const spu_overlay_code_segment* code, unsigned count)
+{
+    if (!span || load_lsa >= SPU_LS_SIZE || span > SPU_LS_SIZE - load_lsa || image_id <= 0 ||
+        owner_image_id <= 0 || !code || !count || s_ovl_static_count >= SPU_OVL_STATIC_MAX)
+        return 0;
+    size_t total = 0;
+    for (unsigned i = 0; i < count; ++i) {
+        if (!code[i].bytes || !code[i].size || code[i].lsa < load_lsa ||
+            code[i].size > span || code[i].lsa - load_lsa > span - code[i].size) return 0;
+        total += code[i].size;
+    }
+    spu_overlay_code_segment* copy = (spu_overlay_code_segment*)malloc(count * sizeof *copy + total);
+    if (!copy) return 0;
+    uint8_t* bytes = (uint8_t*)(copy + count);
+    for (unsigned i = 0; i < count; ++i) {
+        copy[i] = code[i];
+        memcpy(bytes, code[i].bytes, code[i].size);
+        copy[i].bytes = bytes;
+        bytes += code[i].size;
+    }
+    const int n = s_ovl_static_count;
+    s_ovl_static[n].owner = owner_image_id; s_ovl_static[n].image_id = image_id;
+    s_ovl_static[n].lsa = load_lsa; s_ovl_static[n].span = span;
+    s_ovl_static[n].code = copy; s_ovl_static[n].count = count;
+    __atomic_store_n(&s_ovl_static_count, n + 1, __ATOMIC_RELEASE);
+    return 1;
+}
+
+/* A dispatch miss at lsa: is a registered static overlay of this context's
+ * image there, with its bytes in local store? Then make its span resident
+ * (verified) and return its image id, else 0. */
+static int spu_overlay_static_adopt(spu_context* ctx, uint32_t lsa)
+{
+    const int n = __atomic_load_n(&s_ovl_static_count, __ATOMIC_ACQUIRE);
+    for (int i = 0; i < n; ++i) {
+        if (s_ovl_static[i].owner != ctx->image_id || lsa < s_ovl_static[i].lsa ||
+            lsa - s_ovl_static[i].lsa >= s_ovl_static[i].span) continue;
+        /* Overlays that take turns in one span differ in their first bytes:
+         * check those first, so a miss for the other one (the interpreter asks
+         * on every instruction it runs) costs 16 bytes, not the whole span. */
+        if (memcmp(ctx->ls + s_ovl_static[i].code[0].lsa, s_ovl_static[i].code[0].bytes,
+                   s_ovl_static[i].code[0].size < 16 ? s_ovl_static[i].code[0].size : 16)) continue;
+        int match = 1;
+        for (unsigned k = 0; match && k < s_ovl_static[i].count; ++k) {
+            const uint8_t* l = ctx->ls + s_ovl_static[i].code[k].lsa;
+            const uint8_t* b = s_ovl_static[i].code[k].bytes;
+            if (memcmp(l, b, s_ovl_static[i].code[k].size)) {
+                static int _m = 0;
+                if (PS3_LOG_FIRST(_m, 16)) {
+                    uint32_t o = 0; while (l[o] == b[o]) o++;
+                    fprintf(stderr, "[spu-ovl] img=%d static overlay image %d not resident: LS 0x%05X differs "
+                            "(miss at 0x%05X) LS:", ctx->image_id, s_ovl_static[i].image_id,
+                            s_ovl_static[i].code[k].lsa + o, lsa);
+                    for (int q = 0; q < 16; q++) fprintf(stderr, "%02X", l[(o & ~15u) + q]);
+                    fprintf(stderr, "\n");
+                }
+                match = 0;
+            }
+        }
+        if (!match) continue;   /* another overlay may take turns in the same span */
+        unsigned slot = 0;
+        while (slot < 4 && ctx->resident_code[slot].image_id) slot++;
+        if (slot == 4) slot = 3;   /* all taken: replace the last */
+        ctx->resident_code[slot].lsa = s_ovl_static[i].lsa;
+        ctx->resident_code[slot].size = s_ovl_static[i].span;
+        ctx->resident_code[slot].source_ea = 0xFFFFFFFFu;   /* any DMA into the span ends residency */
+        ctx->resident_code[slot].image_id = s_ovl_static[i].image_id;
+        ctx->resident_code[slot].verify_state = 0;
+        ctx->resident_code[slot].source_index = 0;
+        spu_dcache_residency_changed(ctx);
+        { static int _n = 0; if (PS3_LOG_FIRST(_n, 16))
+            fprintf(stderr, "[spu-ovl] img=%d static overlay image %d resident at LS 0x%05X (+0x%X)\n",
+                    ctx->image_id, s_ovl_static[i].image_id, s_ovl_static[i].lsa, s_ovl_static[i].span); }
+        return s_ovl_static[i].image_id;
+    }
+    return 0;
+}
