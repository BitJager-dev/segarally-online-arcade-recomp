+/* Submission slots. A batch the draw path fills up is submitted without a
+ * wait and recording moves on to the next slot's command buffer, so the CPU
+ * records the next batch while the GPU runs this one; a slot is reused only
+ * after its fence has signalled. Each slot has its own part of the batching
+ * rings and its own descriptor pool (vk_eb_*). Every other submission
+ * (vk_submit_and_wait) still waits, and for all slots, so whatever reads
+ * results or frees resources after it sees everything finished. Slot 0 is
+ * s_vk.cmd/s_vk.fence as created; s_vk.cmd/fence name the current slot. */
+#define VK_SLOTS 3u
+static struct { VkCommandBuffer cmd; VkFence fence; int inflight; uint64_t q_end; } s_slot[VK_SLOTS];
+static u32 s_cur;
+static uint64_t vk_zq_next(void);              /* the ZPASS query ring (vk_zq_*) */
+static void vk_zq_resolve_upto(uint64_t upto);
+
+static void vk_slots_wait_all(void)
+{
+    for (u32 k = 0; k < VK_SLOTS; k++)
+        if (s_slot[k].inflight) {
+            pvkWaitForFences(s_vk.device, 1, &s_slot[k].fence, VK_TRUE, UINT64_MAX);
+            s_slot[k].inflight = 0;
+        }
+}
