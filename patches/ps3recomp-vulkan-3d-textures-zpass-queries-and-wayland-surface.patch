diff --git a/libs/video/vulkan/rsx_vk_rgba8_y16x16.comp b/libs/video/vulkan/rsx_vk_rgba8_y16x16.comp
new file mode 100644
index 0000000..367ac96
--- /dev/null
+++ b/libs/video/vulkan/rsx_vk_rgba8_y16x16.comp
@@ -0,0 +1,17 @@
+#version 450
+// An RGBA8 colour target (copied into `d`, one R,G,B,A texel per word) as the texels a Y16_X16
+// texture read of the same memory decodes to. The guest stores the target A,R,G,B per pixel, and
+// Y16_X16 reads those four bytes as two big-endian 16-bit channels: X = A:R, Y = G:B.
+layout(local_size_x = 64) in;
+layout(std430, binding = 0) readonly buffer In { uint d[]; };
+layout(std430, binding = 1) writeonly buffer Out { uint o[]; };
+layout(push_constant) uniform P { uint n; } p;
+
+void main()
+{
+    uint i = gl_GlobalInvocationID.x;
+    if (i >= p.n) return;
+    uint u = d[i];
+    uint r = u & 0xFFu, g = (u >> 8) & 0xFFu, b = (u >> 16) & 0xFFu, a = u >> 24;
+    o[i] = ((a << 8) | r) | (((g << 8) | b) << 16);
+}
