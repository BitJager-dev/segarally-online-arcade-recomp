+/* Submit the current slot without waiting and make the next one current,
+ * waiting for its previous batch if that is still running. Without the extra
+ * slots (before init finished) it waits, as before. */
+static int vk_submit_async(void)
+{
+    if (!s_slot[VK_SLOTS - 1].cmd) return vk_submit_and_wait();
+    VK_CHECK(pvkEndCommandBuffer(s_vk.cmd), "vkEndCommandBuffer");
+    VkSubmitInfo si = { .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+                        .commandBufferCount = 1, .pCommandBuffers = &s_vk.cmd };
+    VK_CHECK(pvkResetFences(s_vk.device, 1, &s_vk.fence), "vkResetFences");
+    VK_CHECK(vk_queue_submit(&si, s_vk.fence), "vkQueueSubmit");
+    s_slot[s_cur].inflight = 1;
+    s_slot[s_cur].q_end = vk_zq_next();
+    s_cur = (s_cur + 1u) % VK_SLOTS;
+    if (s_slot[s_cur].inflight) {
+        pvkWaitForFences(s_vk.device, 1, &s_slot[s_cur].fence, VK_TRUE, UINT64_MAX);
+        s_slot[s_cur].inflight = 0;
+        vk_zq_resolve_upto(s_slot[s_cur].q_end);   /* that batch's counts are final */
+    }
+    s_vk.cmd = s_slot[s_cur].cmd;
+    s_vk.fence = s_slot[s_cur].fence;
