+    VkShaderModule sm[VK_DC_PASSES];
+    VkDescriptorSetLayout dsl;
+    VkPipelineLayout pl;
+    VkPipeline pipe[VK_DC_PASSES];
+    VkDescriptorPool pool;
+    VkDescriptorSet set;
+    vk_buffer in, out;
+    int failed;
+} s_dc;
+
+static int vk_dc_init(void)
+{
+    if (s_dc.pipe[VK_DC_PASSES - 1]) return 0;
+    if (s_dc.failed) return -1;
+    s_dc.failed = 1;
+    static const struct { const uint32_t* code; size_t size; } spv[VK_DC_PASSES] = {
+        { rsx_vk_depth_argb_comp_spv, sizeof rsx_vk_depth_argb_comp_spv },
+        { rsx_vk_rgba8_y16x16_comp_spv, sizeof rsx_vk_rgba8_y16x16_comp_spv },
+    };
+    for (int k = 0; k < VK_DC_PASSES; k++) {
