+#version 450
+// A float depth buffer (copied into `d`) as the bytes a Z24S8 zeta read as A8R8G8B8 holds, packed
+// R8G8B8A8: R = depth bits 15..8, G = bits 7..0, B = 0 (stencil), A = bits 23..16, with
+// v = round(depth * 0xFFFFFF) taken exactly, as the engine's guest store takes it.
+layout(local_size_x = 64) in;
+layout(std430, binding = 0) readonly buffer In { float d[]; };
+layout(std430, binding = 1) writeonly buffer Out { uint o[]; };
+layout(push_constant) uniform P { uint n; } p;
+
+// round(x * (2^24 - 1)) for x in [0, 1]: x = m * 2^-s with a 24-bit m, so the product is
+// (m * 2^24 - m) * 2^-s, rounded by adding half an ulp and shifting; 64-bit as two words.
+uint depth24(float x)
+{
+    if (x >= 1.0) return 0xFFFFFFu;
+    if (!(x > 0.0)) return 0u;
+    uint b = floatBitsToUint(x);
+    uint e = (b >> 23) & 0xFFu;
+    uint m = (b & 0x7FFFFFu) | (e != 0u ? 0x800000u : 0u);
+    uint s = 150u - max(e, 1u);
+    if (s >= 64u) return 0u;
+    uint hi, lo;
+    umulExtended(m, 0xFFFFFFu, hi, lo);
+    uint h = s - 1u;
+    if (h < 32u) { uint add = 1u << h; uint nl = lo + add; hi += (nl < lo) ? 1u : 0u; lo = nl; }
+    else hi += 1u << (h - 32u);
+    if (s >= 32u) return hi >> (s - 32u);
+    return (lo >> s) | (hi << (32u - s));
+}
