+/* ---- ZPASS pixel counts ----------------------------------------------------
+ * NV4097_GET_REPORT type 1 is the number of samples that passed since the
+ * last CLEAR_REPORT_VALUE, counted while SET_ZPASS_PIXEL_COUNT_ENABLE is on.
+ * The runtime used to answer 0xFFFF for every query ("visible"), which is
+ * right for occlusion culling and wrong for a title that measures with it:
+ * SEGA Rally Online Arcade meters scene brightness by drawing its 320x180
+ * luminance image once per brightness band, discarding the pixels outside it,
+ * and reading the counts back. 65535 pixels in every band of a 57600-pixel
+ * image drove its exposure up until the scene was white. Each counted draw
+ * is one occlusion query; a report sums the finished ones into the total. */
+#define VK_ZQ_CAP 1024u
+static struct {
+    VkQueryPool pool;
+    int         tried, precise;
+    u32         used;                 /* queries recorded since the last collect */
+    uint64_t    total;
+} s_zq;
+
+static int vk_zq_ready(void)
+{
+    if (s_zq.pool) return 1;
+    if (s_zq.tried || !s_vk.device) return 0;
+    s_zq.tried = 1;
+    VkQueryPoolCreateInfo qci = { .sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO,
+                                  .queryType = VK_QUERY_TYPE_OCCLUSION, .queryCount = VK_ZQ_CAP };
+    if (pvkCreateQueryPool(s_vk.device, &qci, NULL, &s_zq.pool) != VK_SUCCESS) s_zq.pool = VK_NULL_HANDLE;
+    return s_zq.pool != VK_NULL_HANDLE;
+}
+
+static void vk_eng_flush(void);
+/* Wait for every recorded query and add its count to the total. */
+static void vk_zq_collect(void)
+{
+    if (!s_zq.pool || !s_zq.used) return;
+    vk_eng_flush();                   /* batched draws still unsubmitted */
+    uint64_t counts[VK_ZQ_CAP];
+    if (pvkGetQueryPoolResults(s_vk.device, s_zq.pool, 0, s_zq.used, sizeof counts, counts,
+                               sizeof counts[0], VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WAIT_BIT)
+        == VK_SUCCESS)
+        for (u32 i = 0; i < s_zq.used; i++) s_zq.total += counts[i];
+    s_zq.used = 0;
+}
+
+extern int rsx_engine_zpass_enabled(void);
+/* For cellGcmSys: the ZPASS count a GET_REPORT stores, or 0xFFFFFFFF when this
+ * backend cannot count (the caller then keeps its old answer). */
+uint32_t rsx_backend_zpass_report(void)
+{
+    if (!vk_zq_ready()) return 0xFFFFFFFFu;
+    const u32 pending = s_zq.used;
+    vk_zq_collect();
+    /* GCM_REPORT_DBG=1: the first 40 reports and every 200th after, with the count. */
+    { static int dbg = -1; static unsigned n = 0;
+      if (dbg < 0) dbg = getenv("GCM_REPORT_DBG") ? 1 : 0;
+      if (dbg && (n < 40 || n % 200 == 0))
+          fprintf(stderr, "[zpass] report #%u: %u queries collected, count %llu%c",
+                  n, pending, (unsigned long long)s_zq.total, 10);
+      n++; }
+    return s_zq.total > 0xFFFFFFFEull ? 0xFFFFFFFEu : (uint32_t)s_zq.total;
+}
+
+/* CLEAR_REPORT_VALUE(ZPASS_PIXEL_CNT): the draws before it count toward nothing. */
+void rsx_backend_zpass_clear(void)
+{
+    if (!s_zq.pool) return;
+    vk_zq_collect();
+    s_zq.total = 0;
+}
