+/* Ask a thread running its lifted image on a host thread to stop (it halts at
+ * its next channel operation, spu_honour_stop_request) and wait up to `ms`
+ * for the host thread to leave. Returns 1 when it no longer runs.
+ *
+ * group_terminate used to mark the group stopped and leave the host threads
+ * running, and group_destroy then freed their contexts and local stores
+ * under them: SEGA Rally destroys and recreates SPU groups at every track
+ * change, and its job workers kept polling in freed memory -- heap
+ * corruption (malloc aborts, a NULL ctx->ls in spu_indirect_branch, crashes
+ * inside the Vulkan driver) a few track changes in. */
+static int spu_thread_stop_and_wait(spu_thread_t* t, unsigned ms)
+{
+    if (!t->running) return 1;
+    if (t->sctx) t->sctx->stop_request = 1;
+#ifdef _WIN32
+    if (t->finish_event) WaitForSingleObject(t->finish_event, ms);
+#else
+    struct timespec dl;
+    clock_gettime(CLOCK_REALTIME, &dl);
+    dl.tv_sec += ms / 1000u;
+    dl.tv_nsec += (long)(ms % 1000u) * 1000000L;
+    if (dl.tv_nsec >= 1000000000L) { dl.tv_sec++; dl.tv_nsec -= 1000000000L; }
+    pthread_mutex_lock(&t->finish_event.mu);
+    while (!t->finish_event.done)
+        if (pthread_cond_timedwait(&t->finish_event.cv, &t->finish_event.mu, &dl) != 0) break;
+    pthread_mutex_unlock(&t->finish_event.mu);
+#endif
+    if (t->running)
+        fprintf(stderr, "[SPU] tid=0x%X did not stop within %u ms\n", t->tid, ms);
+    return !t->running;
+}
