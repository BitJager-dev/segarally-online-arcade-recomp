+/* See SPU_MB_ACK in sys_spu_thread_write_spu_mb_handler. */
+static void spu_mb_ack_dead(spu_thread_t* t, uint32_t port, uint32_t val)
+{
+    { static int n = 0; if (PS3_LOG_FIRST(n, 16))
+        fprintf(stderr, "[SPU] SPU_MB_ACK: tid=0x%X is not running; word 0x%08X answered "
+                "on port 0x%X\n", t->tid, val, port); }
+    ydkj_spu_out_mbox_deliver(t->group_id, t->tid, 1, ((port & 0xFFu) << 24) | 1u);
+}
