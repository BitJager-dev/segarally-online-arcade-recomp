diff --git a/libs/audio/cellAudio.c b/libs/audio/cellAudio.c
index 02b751b..ceb0fef 100644
--- a/libs/audio/cellAudio.c
+++ b/libs/audio/cellAudio.c
@@ -20,6 +20,7 @@
 #include <stdlib.h>
 #include <stdint.h>
 #include <math.h>
+#include <time.h>
 #include "ps3emu/log_first.h"
 #include "ps3emu/thread_name.h"
 
@@ -180,7 +181,7 @@ static int audio_backend_init(void)
     want.freq     = CELL_AUDIO_SAMPLE_RATE;
     want.format   = AUDIO_F32SYS;
     want.channels = 2;
-    want.samples  = CELL_AUDIO_BLOCK_SAMPLES;
+    want.samples  = CELL_AUDIO_BLOCK_SAMPLES * 4;   /* 21 ms: a 5 ms device buffer crackled on PipeWire */
     want.callback = NULL; /* We'll use SDL_QueueAudio */
 
     s_sdl_audio_dev = SDL_OpenAudioDevice(NULL, 0, &want, &have, 0);
@@ -209,12 +210,21 @@ static void audio_backend_submit(const float* stereo_samples, u32 num_samples)
     }
 }
 
-/* SDL queues without bound: keep about four blocks ahead of the device. */
+/* SDL queues without bound: keep PS3_AUDIO_BUF_MS (default 64 ms, twelve
+ * blocks) ahead of the device. Four blocks (21 ms) underran PipeWire under
+ * load -- a shader compile, a busy core -- and every underrun is a pop. */
 static int audio_backend_room(void)
 {
     if (!s_sdl_audio_dev) return -1;
-    return SDL_GetQueuedAudioSize(s_sdl_audio_dev) / (2 * sizeof(float)) <
-           CELL_AUDIO_BLOCK_SAMPLES * 4 ? CELL_AUDIO_BLOCK_SAMPLES : 0;
+    static u32 ahead = 0;
+    if (!ahead) {
+        const char* e = getenv("PS3_AUDIO_BUF_MS");
+        const int ms = e && atoi(e) > 0 ? atoi(e) : 64;
+        ahead = (u32)ms * CELL_AUDIO_SAMPLE_RATE / 1000u;
+        if (ahead < CELL_AUDIO_BLOCK_SAMPLES * 2) ahead = CELL_AUDIO_BLOCK_SAMPLES * 2;
+    }
+    return SDL_GetQueuedAudioSize(s_sdl_audio_dev) / (2 * sizeof(float)) < ahead
+           ? CELL_AUDIO_BLOCK_SAMPLES : 0;
 }
 
 static void audio_backend_wait(void) { SDL_Delay(1); }
@@ -649,22 +659,56 @@ static unsigned __stdcall audio_mix_thread_func(void* arg)
     return 0;
 }
 #else
+static uint64_t audio_now_ns(void)
+{
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+}
+
 static void* audio_mix_thread_func(void* arg)
 {
     (void)arg;
     printf("[cellAudio] Mixing thread started\n");
 
+    /* Pace like the Windows thread: one block per 5.33 ms, as the PS3 consumes
+     * them. The old usleep(2000)/usleep(5000) loop keyed on the SDL queue
+     * depth, so with no device it mixed ~500 blocks/s, and with one the queue
+     * (unbounded in SDL) grew with every block the sleep undershot. The guest
+     * paces its own mixer on these block notifications, so a fast clock plays
+     * its audio fast. With a device: stay about four blocks ahead of it. With
+     * none: the monotonic clock. */
+    const uint64_t t_start = audio_now_ns();
+    unsigned long long blocks = 0;
     while (s_mix_thread_running) {
+        const int room = audio_backend_room();
+        if (room >= 0 && room < CELL_AUDIO_BLOCK_SAMPLES) { audio_backend_wait(); continue; }
+        if (room < 0) {
+            const uint64_t due = t_start + blocks * CELL_AUDIO_BLOCK_SAMPLES * 1000000000ull / CELL_AUDIO_SAMPLE_RATE;
+            if (audio_now_ns() < due) { usleep(1000); continue; }
+        }
+        blocks++;
         audio_mix_one_block();
+        /* AUDIO_PEAK=1 / AUDIO_WAV=<file> / AUDIO_RATE=1: as on Windows. */
+        { static int _ap = -1; if (_ap < 0) _ap = getenv("AUDIO_PEAK") ? 1 : 0;
+          if (_ap) { static unsigned _n = 0; float pk = 0.0f;
+            for (u32 i = 0; i < CELL_AUDIO_BLOCK_SAMPLES * 2; i++) {
+                float a = s_mix_buffer[i]; if (a < 0) a = -a; if (a > pk) pk = a; }
+            if ((++_n % 200) == 0 || (pk > 0.001f && _n < 40))
+                fprintf(stderr, "[audio-peak] block#%u peak=%.4f\n", _n, pk); } }
+        { static FILE* _wf = (FILE*)-1;
+          if (_wf == (FILE*)-1) { const char* e = getenv("AUDIO_WAV"); _wf = e ? fopen(e, "wb") : NULL; }
+          if (_wf) { fwrite(s_mix_buffer, sizeof(float), CELL_AUDIO_BLOCK_SAMPLES * 2, _wf); fflush(_wf); } }
         audio_backend_submit(s_mix_buffer, CELL_AUDIO_BLOCK_SAMPLES);
+        { static int on = -1; if (on < 0) on = getenv("AUDIO_RATE") ? 1 : 0;
+          if (on) { static uint64_t t0; static unsigned n, z;
+            const uint64_t now = audio_now_ns(); if (!t0) t0 = now; n++;
+            { int nz = 0; for (u32 i = 0; i < CELL_AUDIO_BLOCK_SAMPLES * 2; i++) if (s_mix_buffer[i] != 0.0f) { nz = 1; break; }
+              if (!nz) z++; }
+            if (now - t0 >= 5000000000ull) {
+                fprintf(stderr, "[audio-rate] %.1f blocks/s (real time 187.5), silent %.1f%%\n",
+                        n * 1e9 / (double)(now - t0), n ? 100.0 * z / n : 0.0);
+                n = z = 0; t0 = now; } } }
         audio_notify_event_queues();
-
-        u32 queued = audio_backend_queued_samples();
-        if (queued > CELL_AUDIO_BLOCK_SAMPLES * 4) {
-            usleep(5000);
-        } else {
-            usleep(2000);
-        }
     }
 
     printf("[cellAudio] Mixing thread stopped\n");
