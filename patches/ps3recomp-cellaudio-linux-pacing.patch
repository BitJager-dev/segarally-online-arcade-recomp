+/* Wait (up to PS3_AUDIO_LATE_MS, default 4 ms) for a writer that is late with
+ * the block about to be mixed: one of a running port whose last block held
+ * sound and whose next one is still all zero (cleared when it was last
+ * consumed, not written since). The PS3 mixes on the clock regardless, but a
+ * PS3 SPU is never descheduled; SEGA Rally's MultiStream writer, an SPU thread
+ * among dozens on a PC, sometimes is, and every block it misses plays as a
+ * zeroed hole -- a pop at each end. The device queue holds tens of ms, so a
+ * few ms of patience cost nothing audible. */
+static int s_port_live[CELL_AUDIO_PORT_MAX];
+static unsigned s_late_ok, s_late_timeout; static uint64_t s_late_ns;   /* AUDIO_RATE */
+#ifndef _WIN32
+static void audio_wait_late_writer(void)
+{
+    static int64_t late_ns = -1;
+    if (late_ns < 0) {
+        const char* e = getenv("PS3_AUDIO_LATE_MS");
+        late_ns = (int64_t)(e ? atoi(e) : 4) * 1000000;
+    }
+    if (late_ns <= 0) return;
+    struct timespec t0; clock_gettime(CLOCK_MONOTONIC, &t0);
+    for (;;) {
+        int waiting = 0;
+        for (int p = 0; p < CELL_AUDIO_PORT_MAX && !waiting; p++) {
+            const AudioPortSlot* port = &s_ports[p];
+            if (!s_port_live[p] || !port->in_use || !port->running || !port->buffer) continue;
+            const u32 nch = (u32)port->param.nChannel, nblock = (u32)port->param.nBlock;
+            const u32* src = (const u32*)(port->buffer + (u32)(port->read_index % nblock) * CELL_AUDIO_BLOCK_SAMPLES * nch);
+            u32 any = 0;
+            for (u32 s = 0; s < CELL_AUDIO_BLOCK_SAMPLES * nch; s++) any |= src[s];
+            waiting = !any;
+        }
+        struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t);
+        const int64_t el = (int64_t)(t.tv_sec - t0.tv_sec) * 1000000000 + (t.tv_nsec - t0.tv_nsec);
+        if (!waiting) { if (el > 100000) { s_late_ok++; s_late_ns += (uint64_t)el; } return; }
+        if (el >= late_ns) { s_late_timeout++; return; }
+        usleep(200);
+    }
+}
+#endif
