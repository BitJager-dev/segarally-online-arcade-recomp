+
 static void* audio_mix_thread_func(void* arg)
 {
     (void)arg;
     printf("[cellAudio] Mixing thread started\n");
 
+    /* Pace like the Windows thread: one block per 5.33 ms, as the PS3 consumes
+     * them. The old usleep(2000)/usleep(5000) loop keyed on the SDL queue
+     * depth, so with no device it mixed ~500 blocks/s, and with one the queue
+     * (unbounded in SDL) grew with every block the sleep undershot. The guest
+     * paces its own mixer on these block notifications, so a fast clock plays
+     * its audio fast. With a device: stay about four blocks ahead of it. With
+     * none: the monotonic clock. */
+    /* Every block on the clock, with or without a device. Mixing whenever the
+     * SDL queue had room consumed blocks in bursts of four (SDL drains its
+     * queue a device period at a time): SEGA Rally's MultiStream writer then
+     * fell a lap behind its 8-block ring and a whole lap (43 ms) played
+     * cleared blocks, a pop at each end, ~8 a second. The queue depth only
+     * steers the period by 2% towards PS3_AUDIO_BUF_MS, and a stall rebases
+     * the clock instead of catching up in a burst. */
+    const uint64_t period = (uint64_t)CELL_AUDIO_BLOCK_SAMPLES * 1000000000ull / CELL_AUDIO_SAMPLE_RATE;
+    uint64_t due = audio_now_ns();
+    (void)audio_backend_wait;
     while (s_mix_thread_running) {
+        const uint64_t now = audio_now_ns();
+        if (now < due) {
+            struct timespec ts = { (time_t)(due / 1000000000ull), (long)(due % 1000000000ull) };
+            clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME, &ts, NULL);
+            continue;
+        }
+        if (now > due + 4 * period) due = now;      /* stalled: start over, no burst */
+        uint64_t next = period;
+        if (audio_backend_room() >= 0) {
+            const u32 q = audio_backend_queued_samples(), target = audio_backend_target_samples();
+            if (q > target + CELL_AUDIO_BLOCK_SAMPLES * 4) { due += period; continue; }   /* far ahead: hold a tick */
+            if (q > target) next = period + period / 50;
+            else if (q < target) next = period - period / 50;
+        }
+        due += next;
+        audio_wait_late_writer();
         audio_mix_one_block();
+        /* AUDIO_PEAK=1 / AUDIO_WAV=<file> / AUDIO_RATE=1: as on Windows. */
+        { static int _ap = -1; if (_ap < 0) _ap = getenv("AUDIO_PEAK") ? 1 : 0;
+          if (_ap) { static unsigned _n = 0; float pk = 0.0f;
+            for (u32 i = 0; i < CELL_AUDIO_BLOCK_SAMPLES * 2; i++) {
+                float a = s_mix_buffer[i]; if (a < 0) a = -a; if (a > pk) pk = a; }
+            if ((++_n % 200) == 0 || (pk > 0.001f && _n < 40))
+                fprintf(stderr, "[audio-peak] block#%u peak=%.4f\n", _n, pk); } }
+        { static FILE* _wf = (FILE*)-1;
+          if (_wf == (FILE*)-1) { const char* e = getenv("AUDIO_WAV"); _wf = e ? fopen(e, "wb") : NULL; }
+          if (_wf) { fwrite(s_mix_buffer, sizeof(float), CELL_AUDIO_BLOCK_SAMPLES * 2, _wf); fflush(_wf); } }
         audio_backend_submit(s_mix_buffer, CELL_AUDIO_BLOCK_SAMPLES);
+        { static int on = -1; if (on < 0) on = getenv("AUDIO_RATE") ? 1 : 0;
+          if (on) { static uint64_t t0; static unsigned n, z;
+            const uint64_t now = audio_now_ns(); if (!t0) t0 = now; n++;
+            { int nz = 0; for (u32 i = 0; i < CELL_AUDIO_BLOCK_SAMPLES * 2; i++) if (s_mix_buffer[i] != 0.0f) { nz = 1; break; }
+              if (!nz) z++; }
+            if (now - t0 >= 5000000000ull) {
+                fprintf(stderr, "[audio-rate] %.1f blocks/s (real time 187.5), silent %.1f%%, "
+                        "late writer: %u waited (avg %.2f ms), %u gave up\n",
+                        n * 1e9 / (double)(now - t0), n ? 100.0 * z / n : 0.0,
+                        s_late_ok, s_late_ok ? s_late_ns / 1e6 / s_late_ok : 0.0, s_late_timeout);
+                s_late_ok = s_late_timeout = 0; s_late_ns = 0;
+                n = z = 0; t0 = now; } } }
         audio_notify_event_queues();
-
-        u32 queued = audio_backend_queued_samples();
-        if (queued > CELL_AUDIO_BLOCK_SAMPLES * 4) {
-            usleep(5000);
-        } else {
-            usleep(2000);
-        }
     }
 
     printf("[cellAudio] Mixing thread stopped\n");
