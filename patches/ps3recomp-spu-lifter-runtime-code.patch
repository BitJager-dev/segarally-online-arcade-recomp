diff --git a/cmake/PS3RecompSPU.cmake b/cmake/PS3RecompSPU.cmake
index 5b8a4d5..4ee98e1 100644
--- a/cmake/PS3RecompSPU.cmake
+++ b/cmake/PS3RecompSPU.cmake
@@ -11,6 +11,11 @@ function(ps3recomp_generate_spu output_dir)
     if(PS3RECOMP_SPU_MERGE_CHUNKS)
         list(APPEND command --merge-chunks)
     endif()
+    # PS3RECOMP_SPU_RUNTIME_CODE: content names (spu_<sha256>) of programs to lift
+    # with data in their code range and calls into code they load at run time.
+    foreach(name IN LISTS PS3RECOMP_SPU_RUNTIME_CODE)
+        list(APPEND command --runtime-code "${name}")
+    endforeach()
     foreach(input IN LISTS ARGN)
         get_filename_component(input "${input}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
         list(APPEND command --input "${input}")
